+/* A51 drop zone (a51-drop.py): read `back` 4 KiB blocks immediately
+ * before the persistent console log at the end of USERDATA. Mirrors
+ * herolte_ufs_read_before_log(); kept in sweet_ufs.c so the A51 kernel
+ * needs no herolte hardware driver. */
+int sweet_ufs_read_before_log(uint64_t back, uint32_t count, void *dst);
+
+int
+sweet_ufs_read_before_log(uint64_t back, uint32_t count, void *dst)
+{
+	if (!su.ready || back == 0 || count == 0 || count > back ||
+	    su.nblocks < SWEET_LOG_BLOCKS + back) {
+		return EINVAL;
+	}
+	uint64_t lba = su.first_block + su.nblocks - SWEET_LOG_BLOCKS - back;
+	int error = 0;
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint32_t done = 0; done < count && !error;) {
+		uint32_t n = MIN(count - done, BOUNCE_SIZE / UFS_BLOCK);
+		error = ufs_read_blocks(lba + done, n);
+		if (!error) {
+			memcpy((uint8_t *)dst + (size_t)done * UFS_BLOCK,
+			    (const void *)(su.dma + DMA_BOUNCE), (size_t)n * UFS_BLOCK);
+		}
+		done += n;
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
