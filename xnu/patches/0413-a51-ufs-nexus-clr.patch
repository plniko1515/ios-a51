+/* Wake the UFS device after bootloader handoff (proven on Exynos: send
+ * TUR + START STOP UNIT(ACTIVE) to the device well-known LUN 0xd0). */
+static int
+ufs_wake_device(void)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	static const uint8_t ssu[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	int error = 0;
+
+	su.lun = 0xd0;
+	for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+	}
+	for (int i = 0; i < 3 && (error = ufs_scsi(ssu, sizeof(ssu), 0, false)); i++) {
+	}
+	su.lun = 0;
+	return error;
+}
