diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index c800a72..8c4686a 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -251,6 +251,8 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
 		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
 		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		panic("A51 UFS CMD FAIL cdb=0x%02x ocs=0x%x upiu=0x%x resp=0x%x status=0x%x",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
 		return EIO;
 	}
 	return 0;
@@ -382,6 +384,9 @@ ufs_take_over_host(void)
 	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
 	    !(ufs_rd(REG_UTRLRSR) & 1)) {
 		printf("SWEET UFS: host did not take our request list\n");
+		panic("A51 UFS TAKEOVER FAIL hce=0x%x hcs=0x%x ba=0x%x bau=0x%x rsr=0x%x",
+		    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_UTRLBA),
+		    ufs_rd(REG_UTRLBAU), ufs_rd(REG_UTRLRSR));
 		return EIO;
 	}
 	return 0;
