--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -721,6 +721,31 @@ static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
 
+#if defined(ARM64_BOARD_CONFIG_A51)
+/* A51 panel is command-mode: FB writes stay in RAM until DECON is told to
+ * push a frame. The verified bring-up sequence (decon_f 0x148B0000):
+ * shadow update +0x60 = 0x80000000, SW trigger +0x70 = 0x00080100 then 0x1. */
+static volatile uint32_t *a51_decon;
+#define A51_DECON_PA     0x148b0000u
+#define A51_DECON_SIZE  0x10000u
+static void
+a51_fb_present(void)
+{
+	if (!a51_decon) {
+		return;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	a51_decon[0x60 / 4] = 0x80000000u;
+	__asm__ volatile("dsb sy" ::: "memory");
+	a51_decon[0x70 / 4] = 0x00080100u;
+	__asm__ volatile("dsb sy" ::: "memory");
+	a51_decon[0x70 / 4] = 0x1u;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#else
+static void a51_fb_present(void) {}
+#endif
+
 static void
 fbcon_clear_row(uint32_t row)
 {
@@ -786,6 +811,7 @@ fbcon_transmit_data(uint8_t c)
 		}
 	}
 	fbcon_col++;
+	a51_fb_present();
 }
 
